# Variáveis de ambiente deste projeto — configuradas nas Environment Variables
# da Netlify (Site settings → Environment variables), nunca num arquivo .env
# local (esse arquivo é só documentação de quais variáveis existem).

# Credencial de service account do Firebase (JSON inteiro, numa linha só),
# usada pelo Admin SDK nas Netlify Functions. Gera em: Firebase Console →
# Project Settings → Service Accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# DSN do Sentry (servidor/Node) — opcional, observabilidade fica desligada
# sem isso. Pegar em sentry.io → criar projeto Node → Settings → Client Keys.
SENTRY_DSN=

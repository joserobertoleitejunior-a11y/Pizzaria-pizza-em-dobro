// ══════════════════════════════════════════════════════════
//  REGRAS DE SEGURANÇA DO FIRESTORE — Pizza em Dobro
//
//  IMPORTANTE — leia antes de publicar:
//  1. Este arquivo NUNCA foi publicado neste projeto (não existia
//     antes). Ninguém aqui tem acesso ao console do Firebase para
//     publicar por vocês — isso precisa ser feito manualmente
//     (Firebase Console → Firestore → Regras, ou `firebase deploy
//     --only firestore:rules` com a CLI autenticada na conta de
//     vocês). Testem num projeto/ambiente de staging antes, ou ao
//     menos testem cada tela (loja, Caixa, Relatórios, Clientes,
//     bot-config) logo depois de publicar, seguindo o padrão da
//     agência de nunca alterar regra em produção sem testar antes.
//
//  2. O que este arquivo GARANTE, sem dúvida: as 3 chaves de API
//     (Anthropic, Evolution, Gemini) em config_secrets/bot ficam
//     100% inacessíveis pelo navegador — nem leitura nem escrita.
//     Só o Admin SDK (Netlify Functions, que ignora estas regras)
//     consegue ler. Esse é o vazamento real que existia: qualquer
//     um que abrisse o Caixa ou o painel bot-config baixava essas
//     chaves junto com os campos públicos do mesmo documento.
//
//  3. O que este arquivo NÃO resolve sozinho: hoje não existe
//     nenhum sistema de login/autenticação real pra equipe (Caixa,
//     Relatórios, bot-config são páginas sem senha, protegidas só
//     por ninguém saber a URL). Sem autenticação de verdade, não
//     dá pra restringir "só a equipe pode escrever pedido/cardápio"
//     nestas regras sem quebrar o funcionamento normal de hoje —
//     por isso as coleções de negócio abaixo continuam com escrita
//     aberta, do jeito que já funcionam agora. Recomendação forte
//     pra próxima etapa: Firebase Authentication (e-mail/senha ou
//     link mágico) pra Caixa/Relatórios/bot-config, e então trocar
//     os "allow write: if true" abaixo por checagem de
//     "request.auth != null" (ou papel/role específico).
// ══════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Segredos: NUNCA acessível pelo navegador, em nenhuma hipótese ──
    match /config_secrets/{doc} {
      allow read, write: if false;
    }

    // ── Config pública (endereço, horário, taxa, mensagens do bot) ──
    // Leitura: usada pela loja, Caixa, bot-config. Escrita: hoje só o
    // painel bot-config e o Caixa (taxa de entrega padrão) gravam aqui;
    // sem login de equipe pra restringir além disso (ver nota 3 acima).
    match /config/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // ── Pedidos: site, Caixa, bot e conversor gravam aqui ──
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true; // Caixa cancela/edita pedido — ver nota 3
    }

    // ── Cardápio ──
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if true; // painel/dashboard-chat editam — ver nota 3
    }

    // ── Contador do número sequencial do pedido (reinicia por dia) ──
    match /contadores/{diaId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Sessões de abertura/fechamento do Caixa ──
    match /caixa_sessoes/{sessaoId} {
      allow read, write: if true;
    }

    // ── Conversas do bot do WhatsApp (lidas pelo Caixa/bot-config/conversas) ──
    match /bot_conversas/{telefone} {
      allow read, write: if true;
      match /mensagens/{msgId} {
        allow read, write: if true;
      }
    }

    // ── Análises de IA do dashboard (só o servidor grava; painel só lê) ──
    match /analises_ia/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Qualquer outra coleção não listada acima fica bloqueada por padrão
    // (comportamento padrão do Firestore quando a coleção não bate com
    // nenhum "match" — mantido explícito aqui só como lembrete).
  }
}

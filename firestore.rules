// ══════════════════════════════════════════════════════════
//  REGRAS DE SEGURANÇA DO FIRESTORE — Pizza em Dobro (v2, banco trancado)
//
//  Princípio: o navegador do CLIENTE só lê o que é público (cardápio,
//  config pública, depoimentos) e só cria o que é dele (avaliação,
//  depoimento, comentário, o próprio perfil Google) — sempre com campo,
//  tipo e tamanho conferidos aqui, e sem < > (nada de HTML/script
//  entrando no banco). Pedido e contador de visitas são criados SÓ
//  pelo servidor (netlify/functions/criar-pedido.js e
//  registrar-visita.js), que usa o Admin SDK e ignora estas regras.
//
//  Equipe = quem passou pela senha (staff-login.js → claim "staff").
//  Cliente logado com Google NÃO é equipe (não tem o claim).
//
//  Testes: tests/firestore-rules.test.js (rodam no emulador local —
//  `npm run test:regras`). Publicar: Firebase Console → Firestore →
//  Regras (colar este arquivo) ou `firebase deploy --only firestore:rules`.
//  Publicar SÓ depois do deploy do site novo (as telas antigas ainda
//  gravam pedido direto do navegador e parariam de funcionar).
// ══════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isEquipe() {
      return request.auth != null && request.auth.token.staff == true;
    }
    function emailDoLogin() {
      // só e-mail VERIFICADO (login Google) — conta com e-mail alheio não verificado não lê nada
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true ? request.auth.token.email : '';
    }
    function textoLimpo(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max && v.matches('[^<>]*');
    }
    function textoOpcional(v, max) {
      return v == null || textoLimpo(v, 0, max);
    }
    function imagemOpcional(v) {
      return v == null || (v is string && v.size() <= 400000 && v.matches('data:image/(jpeg|png|webp);base64,.*'));
    }
    function urlFotoOpcional(v) {
      return v == null || (v is string && v.size() <= 600 && v.matches('https://[^<>" ]+'));
    }
    function so(campos) {
      return request.resource.data.keys().hasOnly(campos);
    }
    function mudouSo(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ── Segredos (chaves de API do bot): ninguém pelo navegador, nunca ──
    match /config_secrets/{doc} {
      allow read, write: if false;
    }

    // ── Config pública (endereço, horário, taxa) ──
    match /config/{doc} {
      allow read: if true;
      allow write: if isEquipe();
    }

    // ── Cardápio ──
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isEquipe();
    }

    // ── Pedidos: equipe tudo; cliente logado com Google só LÊ os próprios.
    //    Criação pública passa pelo servidor (criar-pedido.js). ──
    match /orders/{orderId} {
      allow read, write: if isEquipe();
      allow read: if emailDoLogin() != '' && resource.data.client_email == emailDoLogin();
    }

    // ── Perfil do cliente (login Google): o próprio cliente grava só os dados
    //    dele; anotações da equipe (admin_obs etc.) só a equipe mexe ──
    match /clients/{email} {
      allow read, write: if isEquipe();
      allow read: if emailDoLogin() == email;
      allow create: if emailDoLogin() == email
        && so(['uid', 'name', 'email', 'photo', 'via_google', 'last_visit', 'updated_at'])
        && request.resource.data.email == email
        && textoOpcional(request.resource.data.get('name', null), 80)
        && urlFotoOpcional(request.resource.data.get('photo', null));
      allow update: if emailDoLogin() == email
        && mudouSo(['uid', 'name', 'photo', 'via_google', 'last_visit', 'updated_at'])
        && textoOpcional(request.resource.data.get('name', null), 80)
        && urlFotoOpcional(request.resource.data.get('photo', null));
    }

    // ── Avaliação pós-pedido (página /cupom/) — só pra pedido que existe ──
    match /avaliacoes/{id} {
      allow read, update, delete: if isEquipe();
      allow create: if so(['pedido_id', 'client_name', 'nota', 'comentario', 'created_at'])
        && request.resource.data.pedido_id is string
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.pedido_id))
        && request.resource.data.nota is int
        && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
        && textoOpcional(request.resource.data.get('comentario', null), 1000)
        && textoOpcional(request.resource.data.get('client_name', null), 80)
        && request.resource.data.created_at is string;
    }

    // ── Depoimentos da loja ──
    match /feedbacks/{id} {
      allow read: if true;
      allow update, delete: if isEquipe();
      allow create: if so(['name', 'stars', 'comment', 'fb_photo', 'via_facebook', 'pizza_photo', 'created_at'])
        && textoLimpo(request.resource.data.name, 1, 60)
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && textoLimpo(request.resource.data.comment, 1, 1000)
        && urlFotoOpcional(request.resource.data.get('fb_photo', null))
        && request.resource.data.get('via_facebook', false) is bool
        && imagemOpcional(request.resource.data.get('pizza_photo', null));
      // curtir: só o contador, de 1 em 1
      allow update: if mudouSo(['likes', 'updated_at'])
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0
        && request.resource.data.likes <= resource.data.get('likes', 0) + 1;
    }

    // ── Comentários nos depoimentos ──
    match /feedback_comments/{id} {
      allow read: if true;
      allow delete: if isEquipe();
      allow update: if isEquipe();
      allow create: if so(['feedback_id', 'author', 'author_uid', 'comment', 'photo', 'tagged_user', 'pizza_photo', 'created_at'])
        && (request.resource.data.feedback_id is string || request.resource.data.feedback_id is int)
        && textoLimpo(request.resource.data.author, 1, 60)
        && textoLimpo(request.resource.data.comment, 1, 600)
        && textoOpcional(request.resource.data.get('tagged_user', null), 60)
        && urlFotoOpcional(request.resource.data.get('photo', null))
        && imagemOpcional(request.resource.data.get('pizza_photo', null))
        && (request.resource.data.get('author_uid', null) == null
            || (request.auth != null && request.resource.data.author_uid == request.auth.uid));
      // o autor (logado) edita só o texto do próprio comentário
      allow update: if request.auth != null
        && resource.data.get('author_uid', null) == request.auth.uid
        && mudouSo(['comment', 'updated_at'])
        && textoLimpo(request.resource.data.comment, 1, 600);
    }

    // ── Só equipe ──
    match /contadores/{diaId} { allow read, write: if isEquipe(); }
    match /caixa_sessoes/{sessaoId} { allow read, write: if isEquipe(); }
    match /motoboys/{motoboyId} { allow read, write: if isEquipe(); }
    match /conv_orders/{id} { allow read, write: if isEquipe(); }
    match /bot_conversas/{telefone} {
      allow read, write: if isEquipe();
      match /mensagens/{msgId} { allow read, write: if isEquipe(); }
    }
    match /visits/{diaId} { allow read: if isEquipe(); allow write: if false; }
    match /analises_ia/{doc} { allow read: if isEquipe(); allow write: if false; }
    match /auditoria/{doc} { allow read: if isEquipe(); allow write: if false; }

    // ── Só o servidor ──
    match /pedidos_excluidos/{doc} { allow read, write: if false; }
    match /seguranca_login/{doc} { allow read, write: if false; }

    // Qualquer coleção não listada: bloqueada (padrão do Firestore).
  }
}
